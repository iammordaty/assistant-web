{% set trackName = track.name %}

{% for artist in track.artists %}
    {% set trackName = trackName|replace({
        (artist): '<a href="' ~ url_for('search.advanced.index', query_params = { name: 'a: ' ~ artist ~ ' OR r: ' ~ artist }) ~ '">' ~ artist ~ '</a>'
    }) %}
{% endfor %}

<span>
    {{ trackName|raw }}
</span>
