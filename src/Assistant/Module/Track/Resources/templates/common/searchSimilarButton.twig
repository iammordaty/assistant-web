{# @var track \Assistant\Module\Track\Model\Track|\Assistant\Module\Track\Model\IncomingTrack #}

<a
    class="btn btn-icon"
    href="{{ url_for('search.advanced.index', query_params = {
        bpm: track.bpm,
        genre: track.genre,
        initial_key: track.initialKey,
        year: track.year,
        track: track.name,
    }) }}"
    data-bs-toggle="tooltip"
    title="Wyszukaj podobne utwory"
>
    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-search" width="24" height="24" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
        <circle cx="10" cy="10" r="7"></circle>
        <line x1="21" y1="21" x2="15" y2="15"></line>
    </svg>
</a>
