<div class="card ast-musical-key-info">
    <div class="card-header card-header-light">
        <a href="{{ url_for('search.advanced.index', query_params = { initial_key: musicalKey }) }}" class="text-reset fw-bold">
            {{ title }}
        </a><span class="text-muted">&nbsp;– informacje</span>
    </div>

    <div class="card-body">
        <div class="container-fluid px-0">
            {% for similarKey in similarKeys %}
                <div class="row align-items-center {% if not loop.last %}pb-2"{% endif %}">
                    <div class="col-7 text-end d-flex fw-bold justify-content-start align-items-center gap-1">
                        <span
                            class="cursor-pointer"
                            data-role="similar-keys:set-key"
                            data-value="{{ similarKey.value }}"
                        >
                            {{ similarKey.title }}
                        </span>

                        {% if similarKey.description %}
                            <span
                                class="form-help"
                                data-bs-toggle="popover"
                                data-bs-trigger="hover"
                                data-bs-placement="right"
                                data-bs-html="true"
                                data-bs-content="{{ similarKey.description }}"
                            >?</span>
                        {% endif %}
                    </div>

                    <div class="col-5">
                        <a
                            href="{{ url_for('search.advanced.index', query_params = { initial_key: similarKey.value }) }}"
                            class="text-reset"
                        >
                            {{ similarKey.value }}
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
