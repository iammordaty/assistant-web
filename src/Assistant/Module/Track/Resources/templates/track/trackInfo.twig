{# @var character \Assistant\Module\Track\Extension\TrackCharacter|null #}
{# AI: wiersze kolumn mają stałą wysokość, aby sąsiednie kolumny leżały na wspólnych liniach
   (Album – Impreza – Barwa, Ścieżka – Agresja – Wokal); dane utworu mają tę samą szerokość także bez analizy Essentii #}
<div class="row g-3 ast-track-details">
    <div class="col-lg-5 col-12">
        <div class="ast-feature-pair">
            <span class="ast-feature-name">Album</span>
            <span>{{ track.album }}</span>
        </div>

        <div class="ast-feature-pair">
            <span class="ast-feature-name">Ścieżka</span>
            <span>{{ track.trackNumber }}</span>
        </div>

        <div class="ast-feature-pair">
            <span class="ast-feature-name">Położenie</span>
            {% include '@common/breadcrumbs.twig' with { breadcrumbs } only %}
        </div>
    </div>

    {% if character %}
        {% if character.moods %}
            <div class="col-lg-4 col-12">
                {% for label, probability in character.moods %}
                    <div class="ast-feature">
                        <span class="ast-feature-name">{{ label }}</span>
                        <div class="progress progress-sm">
                            <div
                                class="progress-bar"
                                style="width: {{ probability }}%"
                                role="progressbar"
                                aria-valuenow="{{ probability }}"
                                aria-valuemin="0"
                                aria-valuemax="100"
                                aria-label="{{ label }}"
                            ></div>
                        </div>
                        <span class="ast-feature-value">{{ probability }}</span>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        <div class="col-lg-3 col-12">
            {% if character.timbre %}
                <div class="ast-feature-pair">
                    <span class="ast-feature-name">Barwa</span>
                    <span>{{ character.timbre }}</span>
                </div>
            {% endif %}

            {% if character.hasVoice is not null %}
                <div class="ast-feature-pair">
                    <span class="ast-feature-name">Wokal</span>
                    <span>{{ character.hasVoice ? 'obecny' : 'brak' }}</span>
                </div>
            {% endif %}

            {% if character.loudness is not null %}
                <div class="ast-feature-pair">
                    <span class="ast-feature-name">Głośność</span>
                    <span>{{ character.loudness|number_format(1, ',') }} LUFS</span>
                </div>
            {% endif %}
        </div>
    {% else %}
        <div class="col-lg-7 col-12 d-flex align-items-center">
            <span class="text-secondary small">
                Dodatkowe danem takie jak barwa, wokal i głośność pojawią się po przeliczeniu utworu
            </span>
        </div>
    {% endif %}
</div>
