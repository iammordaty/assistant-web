{# AI: tryby grania na żywo w jednym rzędzie, ze skrótami 1–9, aby zmiana kierunku zajmowała jedno naciśnięcie
   klawisza; pasek leży pod parametrami, więc jego pojawienie się nie przesuwa dostawców, a objaśnienie trybu
   jest w podpowiedzi, a nie w osobnym wierszu #}
<div class="ast-live-modes {% if not form.isLiveMode %}d-none{% endif %}" data-role="similar-tracks:live-modes">
    {% for mode in form.liveModes %}
        <button
            type="button"
            class="ast-live-mode {% if mode == form.request.mode %}active{% endif %}"
            data-role="similar-tracks:mode"
            data-mode="{{ mode.value }}"
            title="{{ mode.description }}"
        >
            <kbd>{{ loop.index }}</kbd>
            {{ mode.label }}
        </button>
    {% endfor %}
    <span
        class="form-help ms-1"
        data-bs-toggle="popover"
        data-bs-trigger="hover"
        data-bs-placement="left"
        data-bs-content="W trybie na żywo dostawców wybiera tryb; wartości gatunku, roku, BPM i tonacji nadal są uwzględniane."
    >?</span>
</div>
