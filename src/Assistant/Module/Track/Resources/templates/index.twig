{% extends '@common/layout.twig' %}

{% block title track.name %}

{% block page_header_avatar %}
    {% include '@track/common/avatar.twig' with { avatar } only %}
{% endblock %}

{% block page_header %}
    {% include '@track/common/header.twig' with { track } only %}
{% endblock %}

{% block page_header_description %}
    {% include '@track/common/headerMeta.twig' with { track, indexedMonth } only %}
{% endblock %}

{% block page_actions %}
    {% include '@track/track/toolbar.twig' with { track } only %}
{% endblock %}

{% block content %}
    <div class="row row-deck row-cards" data-role="track:container" data-track-edit-url="{{ url_for('track.edit.edit', { pathname: track.pathname }) }}">
        {% include '@track/common/wave.twig' with { track } only %}

        <div class="col-12">
            <div class="card">
                <div class="card-body py-3">
                    {% include '@track/track/character.twig' with { character, pathname: track.pathname } only %}
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card" data-role="similar-tracks:container">
                <div class="card-header cursor-pointer flex-wrap row-gap-2" data-role="similar-tracks:toggle-visibility" aria-expanded="false">
                    <h3 class="card-title d-flex align-items-center gap-1 text-nowrap">
                        Powiązane utwory
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon ast-collapse-chevron text-secondary" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                            <path d="M6 9l6 6l6 -6"></path>
                        </svg>
                    </h3>
                    <span class="ast-active-preset ms-2" data-role="similar-tracks:active-preset">
                        · <strong>{{ form.request.mode.label }}</strong>
                    </span>
                    <div class="card-actions ast-similar-tracks-actions">
                        <div
                            class="input-group input-group-flat ast-filter-similar-tracks position-relative"
                            data-bs-toggle="tooltip"
                            title="Filtruj utwory"
                        >
                            <span class="input-group-text cursor-default">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    class="icon icon-tabler icons-tabler-outline icon-tabler-filter-2"
                                >
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path d="M4 6h16" />
                                    <path d="M6 12h12" /><path d="M9 18h6" />
                                </svg>
                            </span>
                            <input
                                data-role="similar-tracks:filter"
                                placeholder="{{ track.genre|lower }}, {{ track.year }}, {{ track.publisher|lower }}..."
                                type="text"
                                class="form-control"
                                value=""
                            >
                            <span class="input-group-text user-select-none ast-filter-similar-tracks-shortcut d-none d-sm-flex">
                                <kbd data-key="ctrlCmd">ctrl</kbd>&nbsp;+&nbsp;<kbd>k</kbd>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="card-body ast-similar-tracks-parameters-container d-none" data-role="similar-tracks:parameters-container">
                    {% include '@track/similarTracks/form.twig' with {
                        form: form,
                        presets: presets,
                        actionUrl: url_for('track.track.index', { guid: track.guid }),
                    } only %}
                </div>
                <div class="card-table table-responsive">
                    {% include '@track/similarTracks/list.twig' with {
                        track: track,
                        similarTracksList: similarTracksList,
                        similarTracksSoftLimit: similarTracksSoftLimit,
                    } only %}
                </div>
                <div
                    class="card-footer {% if similarTracksList|length <= similarTracksSoftLimit %}d-none{% endif %}"
                    data-role="similar-tracks:footer"
                >
                    <div class="text-center">
                        <button type="button" class="btn" data-role="similar-tracks:show-more">Pokaż więcej</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% include '@track/common/modal-music-classifier-metadata.twig' with {
        track,
        url: url_for('track.music-classifier-metadata.get', { guid: track.guid }),
    } only %}

    <script src="/vendor/wavesurfer.min.js" type="text/javascript"></script>
    <script type="module" src="/js/track.js"></script>
{% endblock %}
