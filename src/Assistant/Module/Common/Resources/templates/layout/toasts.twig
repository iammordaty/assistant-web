{% set flash = flash|default({}) %}

{% set toast_class = {
    'success': 'text-bg-success',
    'error': 'text-bg-danger',
    'warning': 'text-bg-warning',
    'info': 'text-bg-info',
} %}

<div class="toast-container position-fixed top-0 end-0 p-3">
    {% for type, messages in flash %}
        {% for message in messages %}
            <div class="toast show align-items-center border-0 {{ toast_class[type]|default('text-bg-secondary') }}"
                 role="alert" aria-live="assertive" aria-atomic="true"
                 data-bs-delay="6000">
                <div class="d-flex">
                    <div class="toast-body">{{ message }}</div>
                    <button type="button"
                            class="btn-close {{ type == 'warning' ? '' : 'btn-close-white' }} me-2 m-auto"
                            data-bs-dismiss="toast" aria-label="Zamknij"></button>
                </div>
            </div>
        {% endfor %}
    {% endfor %}
</div>
