<button
    class="btn btn-icon"
    data-role="toggle-ignore"
    data-url="{{ url_for('collection.status.toggle-ignore') }}"
    data-hash="{{ issue.hash }}"
    title="{{ issue.ignored ? 'Przywróć' : 'Akceptuj' }}"
>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-circle-check{{ issue.ignored ? ' d-none' : '' }}" data-element="icon-accept">
        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
        <path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" />
        <path d="M9 12l2 2l4 -4" />
    </svg>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-back-up{{ issue.ignored ? '' : ' d-none' }}" data-element="icon-restore">
        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
        <path d="M9 14l-4 -4l4 -4" />
        <path d="M5 10h11a4 4 0 1 1 0 8h-1" />
    </svg>
</button>
