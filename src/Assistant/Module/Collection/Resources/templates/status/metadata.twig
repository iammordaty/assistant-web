{% if metadata|length == 0 %}
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <p class="text-muted mb-0">Brak problemów w tej kategorii.</p>
            </div>
        </div>
    </div>
{% else %}
    {% for section in metadata %}
        <div class="col-12">
            <div class="card">
                <div class="card-header card-header-light">
                    <h3 class="card-title">
                        {{ section.label }}
                        <span class="text-muted fs-5 ms-1">({{ section.issues|length }})</span>
                    </h3>
                </div>
                <div class="card-body">
                    <div class="divide-y">
                        {% for issue in section.issues %}
                            <div class="row py-2 align-items-start {{ issue.ignored ? 'text-muted' : '' }}">
                                <div class="col">
                                    {% if section.type == 'empty_metadata' %}
                                        {% if issue.details.track is defined %}
                                            {% include '@collection/status/trackinfo.twig' with {
                                                track: issue.details.track,
                                                file: issue.details.file|default({}),
                                                highlight_field: issue.details.field
                                            } only %}
                                        {% else %}
                                            <a class="text-reset" href="{{ url_for('track.track.index', { guid: issue.details.guid }) }}">
                                                {{ issue.details.track_name }}
                                            </a>
                                            <span class="text-danger ms-1">{{ issue.details.field }}</span>
                                        {% endif %}

                                    {% elseif section.type == 'low_bitrate' %}
                                        {% if issue.details.track is defined %}
                                            {% include '@collection/status/trackinfo.twig' with {
                                                track: issue.details.track,
                                                file: issue.details.file|default({})
                                            } only %}
                                        {% else %}
                                            <a class="text-reset" href="{{ url_for('track.track.index', { guid: issue.details.guid }) }}">
                                                {{ issue.details.track_name }}
                                            </a>
                                        {% endif %}
                                        <span class="text-danger small ms-1">{{ issue.details.bitrate }} kbps</span>

                                    {% elseif section.type == 'suspicious_year' %}
                                        {% if issue.details.track is defined %}
                                            {% include '@collection/status/trackinfo.twig' with {
                                                track: issue.details.track,
                                                file: issue.details.file|default({}),
                                                highlight_field: 'year'
                                            } only %}
                                        {% else %}
                                            <a class="text-reset" href="{{ url_for('track.track.index', { guid: issue.details.guid }) }}">
                                                {{ issue.details.track_name }}
                                            </a>
                                            <span class="text-danger ms-1">{{ issue.details.value }}</span>
                                        {% endif %}

                                    {% elseif section.type in ['similar_artist', 'similar_publisher', 'similar_genre'] %}
                                        {% set search_field = section.type == 'similar_artist' ? 'name' : (section.type == 'similar_publisher' ? 'publisher' : 'genre') %}
                                        {% set search_prefix = section.type == 'similar_artist' ? 'a:' : '' %}

                                        {# Side A: outlier (lower count) - show tracks or search link #}
                                        {% if issue.details.tracks_a is defined and issue.details.tracks_a %}
                                            {% for entry in issue.details.tracks_a %}
                                                {% include '@collection/status/trackinfo.twig' with {
                                                    track: entry.track,
                                                    file: entry.file|default({})
                                                } only %}
                                            {% endfor %}
                                        {% else %}
                                            <a class="text-reset" href="{{ url_for('search.advanced.index', query_params = { (search_field): search_prefix ~ issue.details.value_a }) }}">
                                                {{ issue.details.value_a }}
                                            </a>
                                            <span class="text-muted">({{ issue.details.count_a }})</span>
                                        {% endif %}

                                        <div class="text-muted my-1">
                                            <small>podobne do</small>

                                            {# Side B: majority - show tracks or search link #}
                                            {% if issue.details.tracks_b is defined and issue.details.tracks_b %}
                                                {% for entry in issue.details.tracks_b %}
                                                    {% include '@collection/status/trackinfo.twig' with {
                                                        track: entry.track,
                                                        file: entry.file|default({})
                                                    } only %}
                                                {% endfor %}
                                            {% else %}
                                                <a class="text-reset" href="{{ url_for('search.advanced.index', query_params = { (search_field): search_prefix ~ issue.details.value_b }) }}">
                                                    {{ issue.details.value_b }}
                                                </a>
                                                <span class="text-muted">({{ issue.details.count_b }})</span>
                                            {% endif %}
                                        </div>

                                    {% elseif section.type in ['rare_genre', 'rare_key'] %}
                                        {% if section.type == 'rare_genre' %}
                                            <a class="text-reset" href="{{ url_for('search.advanced.index', query_params = { genre: issue.details.value }) }}">
                                                <strong>{{ issue.details.value }}</strong>
                                            </a>
                                        {% else %}
                                            <strong>{{ issue.details.value }}</strong>
                                        {% endif %}
                                        <span class="text-muted ms-1">{{ issue.details.count }} {{ issue.details.count == 1 ? 'wystąpienie' : 'wystąpienia' }}</span>
                                    {% endif %}
                                </div>
                                <div class="col-auto">
                                    {% include '@collection/status/infobutton.twig' with { issue: issue } only %}
                                    {% include '@collection/status/ignorebutton.twig' with { issue: issue } only %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}
{% endif %}
