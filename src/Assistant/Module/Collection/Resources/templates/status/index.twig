{% extends '@common/layout.twig' %}

{% block title 'Status kolekcji' %}

{% block page_header 'Status kolekcji' %}

{% block page_header_description %}
    {% if summary %}
        Ostatnia analiza: {{ summary.created_at|date('d.m.Y, H:i') }}
    {% endif %}
{% endblock %}

{% block page_actions %}
    <button
        class="btn"
        data-role="run-collection-analysis"
        title="Uruchom analizę kolekcji"
    >
        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M20 11a8.1 8.1 0 0 0 -6.986 -6.918a8.095 8.095 0 0 0 -8.019 3.918" />
            <path d="M4 13a8.1 8.1 0 0 0 15 3" />
            <path d="M19 16a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
            <path d="M5 8a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
            <path d="M9 12a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
        </svg>
        Sprawdź teraz
    </button>
{% endblock %}

{% block content %}
    {% if not summary %}
        <div class="card">
            <div class="card-body">
                <div class="empty">
                    <p class="empty-title">Brak danych</p>
                    <p class="empty-subtitle text-muted">
                        Uruchom analizę kolekcji, aby zobaczyć wyniki.
                    </p>
                    <p class="empty-subtitle text-muted">
                        <code>php bin/console.php collection:analyze</code>
                    </p>
                </div>
            </div>
        </div>
    {% else %}
        {% set totalUnignored = 0 %}
        {% for category in categories %}
            {% set totalUnignored = totalUnignored + unignoredCounts[category.value] %}
        {% endfor %}

{#        {% if totalUnignored == 0 %}#}
{#            <div class="alert alert-success mb-3">#}
{#                Kolekcja wygląda dobrze#}
{#            </div>#}
{#        {% else %}#}
{#            <div class="alert alert-warning mb-3">#}
{#                Znaleziono <strong>{{ totalUnignored }}</strong> {{ totalUnignored == 1 ? 'problem' : (totalUnignored < 5 ? 'problemy' : 'problemów') }} wymagających uwagi.#}
{#            </div>#}
{#        {% endif %}#}

        <div class="row row-deck row-cards mb-3">
            <div class="col-sm-6 col-lg-3">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="bg-primary text-white avatar">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><circle cx="6" cy="17" r="3"></circle><circle cx="16" cy="17" r="3"></circle><polyline points="9 17 9 4 19 4 19 17"></polyline><line x1="9" y1="8" x2="19" y2="8"></line></svg>
                                </span>
                            </div>
                            <div class="col">
                                <div class="fw-bold fs-3">{{ summary.tracks_in_db }}</div>
                                <div class="text-muted">Utworów w bazie</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="bg-green text-white avatar">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M5 4h4l3 3h7a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-11a2 2 0 0 1 2 -2"></path></svg>
                                </span>
                            </div>
                            <div class="col">
                                <div class="fw-bold fs-3">{{ summary.directories_count }}</div>
                                <div class="text-muted">Katalogów</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="bg-azure text-white avatar">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M11 3l9 9a1.5 1.5 0 0 1 0 2l-6 6a1.5 1.5 0 0 1 -2 0l-9 -9v-4a4 4 0 0 1 4 -4h4"></path><circle cx="9" cy="9" r="2"></circle></svg>
                                </span>
                            </div>
                            <div class="col">
                                <div class="fw-bold fs-3">{{ summary.genres_count }}</div>
                                <div class="text-muted">Gatunków</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="bg-purple text-white avatar">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><circle cx="12" cy="7" r="4"></circle><path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"></path></svg>
                                </span>
                            </div>
                            <div class="col">
                                <div class="fw-bold fs-3">{{ summary.artists_count }}</div>
                                <div class="text-muted">Wykonawców</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <ul class="nav nav-tabs card-header-tabs" role="tablist">
                    {% for category in categories %}
                        {% set unignoredCount = unignoredCounts[category.value] %}
                        <li class="nav-item" role="presentation">
                            <a
                                class="nav-link {{ loop.first ? 'active' : '' }}"
                                id="tab-{{ category.value }}"
                                data-bs-toggle="tab"
                                href="#tab-content-{{ category.value }}"
                                role="tab"
                            >
                                {{ category.label }}
                                {% if unignoredCount > 0 %}
                                    <span class="badge bg-warning ms-1">{{ unignoredCount }}</span>
                                {% endif %}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            <div class="tab-content">
                <div class="tab-pane active show" id="tab-content-collection" role="tabpanel">
                    <div class="card-body">
                        <div class="row row-deck row-cards">
                            {% include '@collection/status/collection.twig' with { collection: collection } only %}
                        </div>
                    </div>
                </div>

                <div class="tab-pane" id="tab-content-metadata" role="tabpanel">
                    <div class="card-body">
                        <div class="row row-deck row-cards">
                            {% include '@collection/status/metadata.twig' with { metadata: metadata } only %}
                        </div>
                    </div>
                </div>

                <div class="tab-pane" id="tab-content-potential_duplicate" role="tabpanel">
                    <div class="card-body">
                        {% include '@collection/status/duplicates.twig' with { duplicates: duplicates } only %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    <div class="modal modal-blur fade" id="rawDataModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Dane z bazy</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zamknij"></button>
                </div>
                <div class="modal-body">
                    <pre id="rawDataContent" class="mb-0" style="white-space: pre-wrap; word-break: break-all;"></pre>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(function () {
            var svgAccept = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-circle-check"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" /><path d="M9 12l2 2l4 -4" /></svg>';
            var svgRestore = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-back-up"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 14l-4 -4l4 -4" /><path d="M5 10h11a4 4 0 1 1 0 8h-1" /></svg>';

            $(document).on('click', '[data-role="toggle-ignore"]', function () {
                var $btn = $(this);
                var hash = $btn.data('hash');

                $.post('{{ url_for('collection.status.toggle-ignore') }}', { hash: hash }, function (data) {
                    var $row = $btn.closest('tr, .row, .py-3');

                    if (data.ignored) {
                        $row.addClass('text-muted');
                        $btn.attr('title', 'Przywróć').html(svgRestore);
                    } else {
                        $row.removeClass('text-muted');
                        $btn.attr('title', 'Akceptuj').html(svgAccept);
                    }
                });
            });

            $(document).on('click', '[data-role="show-raw-data"]', function () {
                var raw = $(this).data('raw');
                $('#rawDataContent').text(JSON.stringify(raw, null, 2));
                new bootstrap.Modal('#rawDataModal').show();
            });

            $('a[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
                history.replaceState(null, null, e.target.getAttribute('href'));
            });

            var hash = window.location.hash;
            if (hash) {
                var tab = $('a[href="' + hash + '"]');
                if (tab.length) {
                    new bootstrap.Tab(tab[0]).show();
                }
            }

            $('[data-role="run-collection-analysis"]').on('click', function () {
                var $btn = $(this);

                $btn.prop('disabled', true).text('Analizowanie...');
            });
        });
    </script>
{% endblock %}
