{% if duplicates|length == 0 %}
    <div class="card">
        <div class="card-body">
            <p class="text-muted mb-0">Brak problemów w tej kategorii.</p>
        </div>
    </div>
{% else %}
    <div class="card">
        <div class="card-header card-header-light">
            <h3 class="card-title">
                Potencjalne duplikaty utworów
                <span class="text-muted fs-5 ms-1">({{ duplicates|length }})</span>
            </h3>
        </div>
        <div class="card-table table-responsive">
            <table class="table table-vcenter">
                <tbody>
                    {% for issue in duplicates %}
                        <tr class="{{ issue.ignored ? 'text-muted' : '' }}">
                            <td>
                                <a class="text-reset" href="{{ url_for('track.track.index', { guid: issue.details.guid_a }) }}">
                                    {{ issue.details.value_a }}
                                </a>
                                <span class="text-muted mx-1">vs</span>
                                <a class="text-reset" href="{{ url_for('track.track.index', { guid: issue.details.guid_b }) }}">
                                    {{ issue.details.value_b }}
                                </a>
                            </td>
                            <td class="w-1">
                                {% include '@collection/status/_ignore_button.twig' with { issue: issue } only %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}
