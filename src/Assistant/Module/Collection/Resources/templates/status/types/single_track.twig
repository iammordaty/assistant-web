{% if issues|length == 0 %}
    <div class="card">
        <div class="card-body">
            <p class="text-muted mb-0">Brak problemów w tej kategorii.</p>
        </div>
    </div>
{% else %}
    <div class="card">
        <div class="card-body">
            <div class="divide-y">
                {% for issue in issues %}
                    <div class="row py-2 align-items-start {{ issue.ignored ? 'text-muted' : '' }}">
                        <div class="col">
                            {% if issue.details.track is defined %}
                                {% set highlightField = null %}
                                {% if viewType.value == 'empty-metadata' %}
                                    {% set highlightField = issue.details.field %}
                                {% elseif viewType.value == 'suspicious-year' %}
                                    {% set highlightField = 'year' %}
                                {% endif %}

                                {% include '@collection/status/trackinfo.twig' with {
                                    track: issue.details.track,
                                    file: issue.details.file|default({}),
                                    highlight_field: highlightField
                                } only %}
                            {% else %}
                                <a class="text-reset" href="{{ url_for('track.track.index', { guid: issue.details.guid }) }}">
                                    {{ issue.details.track_name }}
                                </a>
                            {% endif %}

                            {% if viewType.value == 'low-bitrate' %}
                                <span class="text-danger small ms-1">{{ issue.details.bitrate }} kbps</span>
                            {% elseif viewType.value == 'empty-metadata' and issue.details.track is not defined %}
                                <span class="text-danger ms-1">{{ issue.details.field }}</span>
                            {% elseif viewType.value == 'suspicious-year' and issue.details.track is not defined %}
                                <span class="text-danger ms-1">{{ issue.details.value }}</span>
                            {% endif %}
                        </div>
                        <div class="col-auto">
                            {% include '@collection/status/infobutton.twig' with { issue: issue } only %}
                            {% include '@collection/status/ignorebutton.twig' with { issue: issue } only %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endif %}
