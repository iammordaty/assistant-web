<div class="card">
    <div class="card-body">
        <div class="divide-y">
            {# ignorowane na koniec listy #}
            {% set issues = issues|sort((a, b) => a.ignored ? 1 : (b.ignored ? -1 : 0)) %}

            {% for issue in issues %}
                <div
                    class="row py-2 align-items-start{% if issue.ignored %} text-muted{% endif %}"
                    data-element="analysis-issue"
                    data-url="{{ url_for('collection.status.toggle-ignore', { hash: issue.hash }) }}"
                >
                    <div class="col">
                        {% if viewType.value == 'rare-genre' %}
                            <a class="text-reset" href="{{ url_for('search.advanced.index', query_params = { genre: issue.details.value }) }}">
                                <strong>{{ issue.details.value }}</strong>
                            </a>
                        {% else %}
                            <strong>{{ issue.details.value }}</strong>
                        {% endif %}
                        <span class="text-muted ms-1">
                            {{ issue.details.count|pluralize({
                                'one': 'wystąpienie',
                                'few': 'wystąpienia',
                                'other': 'wystąpień',
                            }) }}
                        </span>
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-icon" data-role="show-raw-data" data-raw="{{ issue.toRawArray|json_encode }}" title="Pokaż dane">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-database-search">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                <path d="M4 6c0 1.657 3.582 3 8 3s8 -1.343 8 -3s-3.582 -3 -8 -3s-8 1.343 -8 3" />
                                <path d="M4 6v6c0 1.657 3.582 3 8 3m8 -3.5v-5.5" />
                                <path d="M4 12v6c0 1.657 3.582 3 8 3" />
                                <path d="M15 18a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                                <path d="M20.2 20.2l1.8 1.8" />
                            </svg>
                        </button>
                        <button class="btn btn-icon{% if issue.ignored %} d-none{% endif %}" data-role="ignore-issue" title="Akceptuj">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-circle-check">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                <path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" />
                                <path d="M9 12l2 2l4 -4" />
                            </svg>
                        </button>
                        <button class="btn btn-icon{% if not issue.ignored %} d-none{% endif %}" data-role="restore-issue" title="Przywróć">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-back-up">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                <path d="M9 14l-4 -4l4 -4" />
                                <path d="M5 10h11a4 4 0 1 1 0 8h-1" />
                            </svg>
                        </button>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
