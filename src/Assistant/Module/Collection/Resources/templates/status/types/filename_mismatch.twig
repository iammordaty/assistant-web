{% if issues|length == 0 %}
    <div class="card">
        <div class="card-body">
            <p class="text-muted mb-0">Brak problemów w tej kategorii.</p>
        </div>
    </div>
{% else %}
    {% for issue in issues %}
        <div class="ast-fmatch-card {{ issue.ignored ? 'ast-status-ignored' : '' }}">
            <div class="ast-fmatch-top">
                <div class="ast-fmatch-track-info">
                    {% if issue.details.track is defined %}
                        {% include '@collection/status/trackinfo.twig' with {
                            track: issue.details.track,
                            file: issue.details.file|default({})
                        } only %}
                    {% else %}
                        <a class="text-reset fw-bold" href="{{ url_for('track.track.index', { guid: issue.details.guid }) }}">
                            {{ issue.details.track_name }}
                        </a>
                    {% endif %}
                </div>
                <div class="ast-fmatch-actions">
                    {% include '@collection/status/infobutton.twig' with { issue: issue } only %}
                    {% include '@collection/status/ignorebutton.twig' with { issue: issue } only %}
                </div>
            </div>
            <div class="ast-fmatch-diff">
                <div class="ast-fmatch-line ast-fmatch-line-expected">
                    <span class="ast-fmatch-line-label">
                        Oczekiwana
                    </span>
                    <span class="ast-fmatch-line-value" data-diff-expected="{{ issue.details.expected }}">{{ issue.details.expected }}</span>
                </div>
                <div class="ast-fmatch-line ast-fmatch-line-actual">
                    <span class="ast-fmatch-line-label">
                        Aktualna
                    </span>
                    <span class="ast-fmatch-line-value" data-diff-actual="{{ issue.details.filename }}">{{ issue.details.filename }}</span>
                </div>
            </div>
        </div>
    {% endfor %}
{% endif %}
