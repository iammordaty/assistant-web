<form data-role="track-search:form" method="GET" action="{{ url_for('search.simple.index') }}" role="form">
    <div class="input-group input-group-flat w-auto">
        <span class="input-group-text">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="icon icon-1">
                <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path>
                <path d="M21 21l-6 -6"></path>
            </svg>
        </span>
        <input
            {% if withAutocompleter|default %}
                data-role="autocompleter"
            {% endif %}
            data-url="{{ url_for('track.track.autocomplete') }}"
            data-follow-on-select="true"
            type="text"
            name="name"
            value="{{ form.name|default }}"
            class="form-control form-control-lg"
            placeholder="Wprowadź nazwę wykonawcy lub tytuł utworu"
        >
        <span class="input-group-text">
            <kbd>/</kbd>
        </span>
    </div>
</form>
