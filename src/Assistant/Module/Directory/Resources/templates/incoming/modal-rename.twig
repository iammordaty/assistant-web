<div class="modal" id="modal-rename" tabindex="-1" aria-modal="true" role="dialog">
    <form action="{{ url_for('common.task.rename') }}" method="POST">
        <input type="hidden" name="elements">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Zmień nazwę</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-4">
                        <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column">
                            {% for format in rename_formats %}
                                <label class="form-selectgroup-item flex-fill">
                                    <input type="radio" name="format" value="{{ format.value }}"
                                           class="form-selectgroup-input" {{ loop.first ? 'checked="checked"' : '' }}>
                                    <div class="form-selectgroup-label d-flex align-items-center p-3">
                                        <div class="me-3">
                                            <span class="form-selectgroup-check"></span>
                                        </div>
                                        <div><i>{{ format.label }}</i></div>
                                    </div>
                                </label>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="mb-3 p-3 pt-0 pb-0">
                        <label class="form-check">
                            <input class="form-check-input" type="checkbox" name="mark_as_ready" value="1">
                            <span class="form-check-label">Oznacz jako gotowy (przenieś do katalogu <i>_zrobione</i>)</span>
                        </label>

                        <label class="form-check">
                            <input class="form-check-input" type="checkbox" name="move_to_date_dir" value="1"
                                   data-role="incoming-tracks:rename:date-dir">
                            <span class="form-check-label">Przenieś do katalogu <i>rok</i> / <i>miesiąc</i></span>
                            <span class="form-check-description">
                                Domyślnie wg daty każdego pliku z osobna. Poniżej można narzucić jedną datę
                                dla całego zaznaczenia.
                            </span>
                        </label>

                        <div class="row g-2 mt-1 ms-4 d-none" data-role="incoming-tracks:rename:date-dir-fields">
                            <div class="col-4">
                                <input type="text" name="date_dir_year" class="form-control rounded"
                                       inputmode="numeric" pattern="\d{4}" placeholder="rok">
                            </div>
                            <div class="col-8">
                                <select name="date_dir_month" class="form-select rounded">
                                    <option value="">(miesiąc z daty pliku)</option>
                                    {% for month in [
                                        '01. styczeń', '02. luty', '03. marzec', '04. kwiecień',
                                        '05. maj', '06. czerwiec', '07. lipiec', '08. sierpień',
                                        '09. wrzesień', '10. październik', '11. listopad', '12. grudzień'
                                    ] %}
                                        <option value="{{ month }}">{{ month }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn me-auto" data-bs-dismiss="modal">Anuluj</button>
                    <button type="submit" class="btn btn-primary">Zmień nazwę</button>
                </div>
            </div>
        </div>
    </form>
</div>
